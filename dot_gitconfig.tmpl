[init]
    defaultBranch = main
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[user]
    signingkey = ~/.ssh/id_rsa.pub
    email = raysuliteanu@pm.me
    name = Ray Suliteanu
[commit]
    verbose = true
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
    line-numbers = true
    hyperlinks = true
    side-by-side = true
    syntax-theme = "Catppuccin Mocha"
    grep-output-type = ripgrep
[merge]
    conflictstyle = diff3
    tool = meld
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[alias]
    co = checkout
    sw = switch
    st = status
    wls = worktree list
[rerere]
    enabled = true
    autoupdate = true
[pull]
    rebase = false
[push]
    autoSetupRemote = true
    default = simple
    followtags = true
[fetch]
    prune = true
    pruneTags = true
    all = true
[help]
    autocorrect = prompt
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[rebase]
    updateRefs = true
    autoSquash = true
    autoStash = true

