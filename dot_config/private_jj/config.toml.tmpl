[user]
name = "Ray Suliteanu"
email = "raysuliteanu@pm.me"

[ui]
default-command = "log"
diff-editor = ["nvim", "-c", "DiffEditor $left $right $output"]
diff-formatter = ":git"
pager = "delta"
show-cryptographic-signatures = true

[aliases]
init = ["git", "init"]

[remotes.origin]
auto-track-bookmarks = "glob:*"

[signing]
backend = "ssh"
behavior = "own"
key = "{{ .chezmoi.homeDir }}/.ssh/id_rsa"

[signing.backends.ssh]
allowed-signers = "{{ .chezmoi.homeDir }}/.ssh/allowed_signers"

[template-aliases]
'format_short_cryptographic_signature(sig)' = '''
if(sig,
  "\nSigned-By: " ++ sig.display(),
  ""
)
'''
