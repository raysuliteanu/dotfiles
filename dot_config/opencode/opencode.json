{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "read": "allow",
        "bash": {
            "*": "ask",
            "git *": "allow",
            "git rm *": "ask",
            "git commit *": "ask",
            "git push *": "deny",
            "npm *": "allow",
            "rm *": "deny",
            "grep *": "allow",
            "find *": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "rg *": "allow",
            "fd *": "allow",
            "bat *": "allow",
            "exa *": "allow"
        },
    },
    "agent": {
        "build": {
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow",
                    "git commit *": "ask",
                    "git push *": "deny",
                    "grep *": "allow",
                    "find *": "allow",
                    "ls *": "allow",
                    "cat *": "allow",
                    "rg *": "allow",
                    "fd *": "allow",
                    "bat *": "allow",
                    "exa *": "allow"
                }
            }
        }
    },
    "mcp": {
        "excalidraw": {
            "type": "local",
            "command": [
                "sh",
                "-lc",
                "mkdir -p \"$HOME/.local/state/excalidraw-mcp\" && cd \"$HOME/.local/state/excalidraw-mcp\" && exec npx -y excalidraw-mcp"
            ]
        }
    },
    "provider": {
        "ollama": {
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "http://rays-mac-mini:11434/v1"
            },
            "models": {
                "qwen2.5-coder:32b-32k": {
                    "name": "Qwen2.5-Coder 32B (Mini)"
                },
                "llama3.1:8b": {
                    "name": "Llama 3.1 8B"
                }
            }
        }
    }
}
