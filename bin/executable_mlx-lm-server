#!/usr/bin/env bash
set -euo pipefail

TAILSCALE=/usr/local/bin/tailscale
MLX_SERVER=/Users/raysuliteanu/.local/share/uv/tools/mlx-lm/bin/mlx_lm.server
MLX_MODEL=mlx-community/gemma-4-26B-A4B-it-OptiQ-4bit
STATE_DIR=/Users/raysuliteanu/.local/share/mlx-lm
PID_FILE=$STATE_DIR/server.pid
PORT_FILE=$STATE_DIR/server.port
LOG_FILE=$STATE_DIR/server.log
DEFAULT_PORT=8888

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [PORT]

Commands:
  start [PORT]   Start the MLX LM server and expose it via tailscale serve
  stop  [PORT]   Stop the MLX LM server and remove the tailscale serve config

PORT defaults to $DEFAULT_PORT. Both the MLX server and tailscale serve use the same port.

Logs: $LOG_FILE
EOF
}

validate_port() {
    local port=$1
    if ! [[ "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1024 ] || [ "$port" -gt 65534 ]; then
        echo "Error: '$port' is not a valid port. Must be between 1024 and 65534." >&2
        exit 1
    fi
}

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

cmd_start() {
    local port="${1:-$DEFAULT_PORT}"
    validate_port "$port"

    if is_running; then
        local running_port
        running_port=$(cat "$PORT_FILE" 2>/dev/null || echo "unknown")
        echo "Error: MLX server is already running on port $running_port (PID $(cat "$PID_FILE"))." >&2
        echo "Run '$(basename "$0") stop' to stop it first." >&2
        exit 1
    fi

    mkdir -p "$STATE_DIR"

    echo "Starting MLX server on port $port..."
    $MLX_SERVER \
        --model "$MLX_MODEL" \
        --host 127.0.0.1 \
        --port "$port" \
        >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    echo "$port" > "$PORT_FILE"

    echo "Configuring tailscale serve: HTTPS $port -> localhost:$port..."
    $TAILSCALE serve --bg --https="$port" "$port"

    echo "MLX server started (PID $(cat "$PID_FILE"))."
    echo "Available at: https://rays-mac-mini.tail029721.ts.net:$port"
    echo "Logs: tail -f $LOG_FILE"
}

cmd_stop() {
    local port="${1:-$DEFAULT_PORT}"
    validate_port "$port"

    if ! is_running; then
        echo "MLX server is not running."
        # Still attempt to clean up tailscale in case it was left configured
        $TAILSCALE serve --https="$port" off 2>/dev/null || true
        rm -f "$PID_FILE" "$PORT_FILE"
        exit 0
    fi

    local running_port
    running_port=$(cat "$PORT_FILE" 2>/dev/null || echo "")
    if [ -n "$running_port" ] && [ "$running_port" != "$port" ]; then
        echo "Warning: MLX server is running on port $running_port, not $port." >&2
        echo "Run '$(basename "$0") stop $running_port' to stop it." >&2
        exit 1
    fi

    local pid
    pid=$(cat "$PID_FILE")
    echo "Stopping MLX server (PID $pid)..."
    kill "$pid"
    rm -f "$PID_FILE" "$PORT_FILE"

    echo "Removing tailscale serve on port $port..."
    $TAILSCALE serve --https="$port" off
    echo "MLX server stopped."
}

case "${1:-}" in
    start) cmd_start "${2:-}" ;;
    stop)  cmd_stop  "${2:-}" ;;
    *)     usage; exit 0 ;;
esac
