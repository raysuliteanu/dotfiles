#!/usr/bin/env bash
set -euo pipefail

MLX_CHAT=${MLX_LM_CHAT:-$(which mlx_lm.chat)}
MLX_MODEL=google/gemma-4-26B-A4B-it

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Chat with an LLM using MLX.

Options:
  --model MODEL         Model to use (default: $MLX_MODEL)
  --max-tokens N        Maximum tokens to generate (default: 32768)
  --temp N              Sampling temperature (default: 0.7)
  --top-p N             Sampling top-p (default: 0.9)
  --system-prompt TEXT  System prompt to use
  --help                Show this help message

Examples:
  $(basename "$0")
  $(basename "$0") --model meta-llama/Llama-3.1-8B-Instruct
  $(basename "$0") --max-tokens 1024 --temp 0.8
EOF
}

# Parse arguments
MODEL="$MLX_MODEL"
MAX_TOKENS=32768
TEMP=0.7
TOP_P=0.9
SYSTEM_PROMPT=""
TRUST_REMOTE_CODE=false

while [[ $# -gt 0 ]]; do
    case $1 in
    --model)
        MODEL="$2"
        shift 2
        ;;
    --max-tokens)
        MAX_TOKENS="$2"
        shift 2
        ;;
    --temp)
        TEMP="$2"
        shift 2
        ;;
    --top-p)
        TOP_P="$2"
        shift 2
        ;;
    --system-prompt)
        SYSTEM_PROMPT="$2"
        shift 2
        ;;
    --trust-remote-code)
        TRUST_REMOTE_CODE=true
        shift
        ;;
    --help)
        usage
        exit 0
        ;;
    *)
        echo "Error: Unknown option: $1" >&2
        usage
        exit 1
        ;;
    esac
done

# Run the chat
ARGS=(
    --model "$MODEL"
    --max-tokens "$MAX_TOKENS"
    --temp "$TEMP"
    --top-p "$TOP_P"
)

if [ "$SYSTEM_PROMPT" != "" ]; then
    ARGS+=(--system-prompt "$SYSTEM_PROMPT")
fi

if [ "$TRUST_REMOTE_CODE" = true ]; then
    ARGS+=(--trust-remote-code)
fi

$MLX_CHAT "${ARGS[@]}"
