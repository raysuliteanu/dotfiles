#!/bin/sh
if [ -n "$TMUX" ]; then
  export TERM=screen-256color
fi

. "$HOME/.cargo/env"

export PAGER='less'
export EDITOR=vi
export BAT_THEME=Coldark-Dark

export XDG_DATA_DIRS="/home/linuxbrew/.linuxbrew/share:$XDG_DATA_DIRS"

export GPG_TTY=$(tty)

export PATH=$PATH:$(brew --prefix)/lib/ruby/gems/3.3.0/bin
